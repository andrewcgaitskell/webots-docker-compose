#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/TPBot.proto"

WorldInfo {
  info [
    "Minimal default world for TPBot development."
  ]
  title "TPBot Default World"
  basicTimeStep 24
}

Viewpoint {
  fieldOfView 0.9
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0 0 1.6
}

Background {
  skyColor [
    1 1 1
  ]
}

DirectionalLight {
  direction 0.3 -0.3 -1
  intensity 1.5
  ambientIntensity 0.6
  castShadows FALSE
}

# NOT the "Floor" PROTO: Webots' infra-red DistanceSensor color-sensitivity
# (used below by TPBot's line sensors) only evaluates correctly against a
# literal Plane geometry - see "Line Following Behavior" in the DistanceSensor
# reference docs. Floor.proto renders its surface as an IndexedFaceSet, which
# looks identical but silently fails to report red_level to the sensor ray,
# so both sensors would read the same value everywhere regardless of the
# printed line. This inline Solid/Plane is the fix, not a style choice.
Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        baseColorMap ImageTexture {
          url [
            "textures/line_circle.png"
          ]
        }
        roughness 0.3
        metalness 0
      }
      geometry Plane {
        size 1 1
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 1 1
  }
  locked TRUE
}

TPBot {
  translation 0 0 0
  controller "bang_bang_line_follower"
}
