#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/TPBot.proto"

WorldInfo {
  info [
    "Minimal default world for TPBot development."
  ]
  title "TPBot Default World"
  basicTimeStep 24
}

Viewpoint {
  fieldOfView 0.9
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0 0 1.6
}

Background {
  skyColor [
    1 1 1
  ]
}

DirectionalLight {
  direction 0.3 -0.3 -1
  intensity 1.5
  ambientIntensity 0.6
  castShadows FALSE
}

# Circle track: 240mm x 240mm canvas with 100mm radius circle, 22mm line width
# Plane size matches the texture dimensions exactly - if the PNG is regenerated
# with different dimensions, this size must be updated to match, or the 22mm
# line width and 15mm sensor spacing will be wrong relative to each other in-sim.
Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        baseColorMap ImageTexture {
          url [
            "textures/circle_R100_240mm.png"
          ]
        }
        roughness 0.3
        metalness 0
      }
      geometry Plane {
        size 0.24 0.24
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 0.24 0.24
  }
  locked TRUE
}

# Starting position: centred on the circle line on the right side, facing
# tangent to the circle (ready to follow counterclockwise).
# Circle centre is at (120mm, 120mm) within the 240mm canvas.
# Right side of circle is at 220mm from canvas left edge, 120mm from top.
# In world coords (origin at plane center): translation (100mm, 0, 0).
TPBot {
  translation 0.10 0 0
  rotation 0 0 1 -1.5708
  controller "bang_bang_line_follower"
}
